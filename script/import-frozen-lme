#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEFAULT_SOURCE_REPO="$(cd "$ROOT/.." && pwd)/af-inference-orchestrator"
SOURCE_REPO="${LME_SOURCE_REPO:-$DEFAULT_SOURCE_REPO}"
SOURCE_SHA="2e34ccfdf0a6e4f6de97ddea8c1876fe489ba839"
MANIFEST="$ROOT/SOURCE_IMPORT_MANIFEST.txt"

if [[ ! -d "$SOURCE_REPO/.git" ]]; then
  printf 'ERROR: local-model-eval Git checkout not found: %s
' "$SOURCE_REPO" >&2
  exit 2
fi

if ! git -C "$SOURCE_REPO" cat-file -e "$SOURCE_SHA^{commit}" 2>/dev/null; then
  printf 'ERROR: frozen local-model-eval commit is unavailable: %s
' "$SOURCE_SHA" >&2
  exit 2
fi

count=0
while IFS=$'\t' read -r source_path destination_path; do
  [[ -z "${source_path:-}" ]] && continue
  [[ "$source_path" == \#* ]] && continue
  destination="$ROOT/$destination_path"
  mkdir -p "$(dirname "$destination")"
  git -C "$SOURCE_REPO" show "$SOURCE_SHA:$source_path" > "$destination"
  count=$((count + 1))
done < "$MANIFEST"

chmod +x "$ROOT/bin/rpof"
for path in "$ROOT"/bin/lme-runpod-* "$ROOT"/scripts/*.sh; do
  [[ -e "$path" ]] && chmod +x "$path"
done

printf 'Imported %d frozen provider files from local-model-eval@%s
' "$count" "$SOURCE_SHA"
printf 'Next: %s/script/verify-frozen-import
' "$ROOT"
