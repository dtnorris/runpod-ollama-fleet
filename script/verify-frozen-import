#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEFAULT_SOURCE_REPO="$(cd "$ROOT/.." && pwd)/af-inference-orchestrator"
SOURCE_REPO="${LME_SOURCE_REPO:-$DEFAULT_SOURCE_REPO}"
SOURCE_SHA="2e34ccfdf0a6e4f6de97ddea8c1876fe489ba839"
MANIFEST="$ROOT/SOURCE_IMPORT_MANIFEST.txt"

if [[ ! -d "$SOURCE_REPO/.git" ]]; then
  printf 'ERROR: local-model-eval Git checkout not found: %s
' "$SOURCE_REPO" >&2
  exit 2
fi

failures=0
checked=0
while IFS=$'\t' read -r source_path destination_path; do
  [[ -z "${source_path:-}" ]] && continue
  [[ "$source_path" == \#* ]] && continue
  destination="$ROOT/$destination_path"
  if [[ ! -f "$destination" ]]; then
    printf 'MISSING  %s
' "$destination_path"
    failures=$((failures + 1))
    continue
  fi
  source_hash="$(git -C "$SOURCE_REPO" show "$SOURCE_SHA:$source_path" | shasum -a 256 | awk '{print $1}')"
  destination_hash="$(shasum -a 256 "$destination" | awk '{print $1}')"
  if [[ "$source_hash" == "$destination_hash" ]]; then
    printf 'PASS     %s
' "$destination_path"
  else
    printf 'MISMATCH %s
' "$destination_path"
    failures=$((failures + 1))
  fi
  checked=$((checked + 1))
done < "$MANIFEST"

printf 'Checked %d imported files; failures=%d
' "$checked" "$failures"
[[ "$failures" -eq 0 ]]
