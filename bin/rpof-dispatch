#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "runpod_ollama_fleet"
require "local_model_evaluation/runpod_fleet_namespace"
require "local_model_evaluation/runpod_fleet_state"

opts = { request: nil, workdir: nil, output: nil, owner_fd: nil, dynamic_worker_admission: false }
interrupted_signal = nil
%w[INT TERM].each do |signal|
  Signal.trap(signal) do
    next if interrupted_signal

    interrupted_signal = signal
    Thread.main.raise(Interrupt, "received #{signal}")
  end
end
parser = OptionParser.new do |o|
  o.banner = "Usage: bin/rpof dispatch --request FILE --workdir DIR --output DIR"
  o.on("--request FILE") { |v| opts[:request] = v }
  o.on("--workdir DIR") { |v| opts[:workdir] = v }
  o.on("--output DIR") { |v| opts[:output] = v }
  o.on("--owner-fd N", Integer, "Inherited WLO owner-liveness pipe") { |v| opts[:owner_fd] = v }
  o.on("--dynamic-worker-admission", "Allow already-prepared workers to join while jobs remain unclaimed") { opts[:dynamic_worker_admission] = true }
end

begin
  parser.parse!(ARGV)
  %i[request workdir output].each { |key| raise OptionParser::MissingArgument, "--#{key}" unless opts[key] }
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
  raise OptionParser::InvalidArgument, "workdir is not a directory" unless File.directory?(File.expand_path(opts[:workdir]))
  request = JSON.parse(File.read(File.expand_path(opts[:request])))
  RunpodOllamaFleet::ContractV01.validate_dispatch_request!(request)
rescue OptionParser::ParseError, JSON::ParserError, SystemCallError, RunpodOllamaFleet::ContractV01::Error => e
  warn "ERROR: #{e.message}"
  exit 2
end

begin
  RunpodOllamaFleet::OwnerWatch.new(fd: opts.fetch(:owner_fd)).start if opts[:owner_fd]
  target = request.fetch("target")
  namespace = LocalModelEvaluation::RunpodFleetNamespace.new(
    root: File.join(ROOT, "output", "runpod-fleets"),
    repo_root: ROOT,
    fleet_key: target.fetch("fleet_key")
  )
  state = LocalModelEvaluation::RunpodFleetState.new(
    root: namespace.state_root,
    local_port_base: namespace.local_port_base
  )
  summary = RunpodOllamaFleet::DispatchV01.new(
    fleet_state: state,
    fleet_key: target.fetch("fleet_key"),
    workdir: opts.fetch(:workdir),
    output_dir: opts.fetch(:output),
    provider_repo_root: namespace.repo_root
  ).run(request, dynamic_worker_admission: opts.fetch(:dynamic_worker_admission))
  puts "Dispatch #{summary.fetch('status')}: #{summary.fetch('completed_count')} completed, #{summary.fetch('failed_count')} failed, #{summary.fetch('not_started_count')} not started."
  exit(summary.fetch("status") == "completed" ? 0 : 1)
rescue LocalModelEvaluation::RunpodFleetNamespace::Error, RunpodOllamaFleet::OwnerWatch::Error => e
  warn "ERROR: #{e.message}"
  exit 1
rescue Interrupt
  signal = interrupted_signal || "INT"
  warn "ERROR: dispatch interrupted by #{signal}; active workload children were terminated"
  exit(128 + Signal.list.fetch(signal, 2))
end
