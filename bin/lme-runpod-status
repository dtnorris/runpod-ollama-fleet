#!/usr/bin/env ruby
# frozen_string_literal: true

require "dotenv"
require "json"
require "optparse"

ROOT = File.expand_path("..", __dir__)
Dotenv.load(File.join(ROOT, ".env"))
$LOAD_PATH.unshift File.join(ROOT, "lib")

require "local_model_evaluation/runpod_client"
require "local_model_evaluation/runpod_activity"
require "local_model_evaluation/runpod_fleet_namespace"
require "local_model_evaluation/runpod_fleet_state"
require "local_model_evaluation/runpod_status"
require "local_model_evaluation/runpod_status_all"
require "local_model_evaluation/runpod_compact_status"
require "local_model_evaluation/runpod_cost_control"
require "local_model_evaluation/runpod_shutdown_control"
require "runpod_ollama_fleet/dynamic_worker_registry"

options = { all: false, verbose: false, json: false, width: LocalModelEvaluation::RunpodCompactStatus::DEFAULT_WIDTH }
begin
  OptionParser.new do |parser|
    parser.banner = "Usage: bin/rpof status [--all] [--verbose | --json] [--width COLUMNS]"
    parser.on("--all") { options[:all] = true }
    parser.on("--verbose") { options[:verbose] = true }
    parser.on("--json") { options[:json] = true }
    parser.on("--width COLUMNS", Integer) { |value| options[:width] = value }
  end.parse!(ARGV)
  raise OptionParser::InvalidArgument, "--verbose and --json are mutually exclusive" if options[:verbose] && options[:json]
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
rescue OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  exit 1
end

all_fleets = options[:all]
compact = LocalModelEvaluation::RunpodCompactStatus.new(width: options[:width])

state_root = ENV["RPOF_STATE_ROOT"].to_s.strip
state_root = File.join(ROOT, "output", "runpod-fleets") if state_root.empty?
state_repo_root = ENV["RPOF_STATE_REPO_ROOT"].to_s.strip
state_repo_root = ROOT if state_repo_root.empty?
api_key = ENV["RUNPOD_API_KEY"].to_s
client = unless api_key.empty?
           LocalModelEvaluation::RunpodClient.new(
             api_key: api_key,
             base_url: ENV.fetch("RUNPOD_API_BASE_URL", LocalModelEvaluation::RunpodClient::DEFAULT_BASE_URL)
           )
         end

build_status = lambda do |namespace|
  state = LocalModelEvaluation::RunpodFleetState.new(
    root: namespace.state_root,
    local_port_base: namespace.local_port_base
  )
  activity_monitor = LocalModelEvaluation::RunpodActivity.new(fleet_state: state)
  readiness_observer = RunpodOllamaFleet::DynamicWorkerRegistry.new(
    state_root: state_root,
    repo_root: state_repo_root,
    fleet_sources: [{ "fleet_key" => namespace.fleet_key, "state" => state }]
  )
  status = LocalModelEvaluation::RunpodStatus.new(
    fleet_state: state,
    client: client,
    activity_monitor: activity_monitor,
    readiness_observer: readiness_observer
  )
  [status, status.snapshot]
end

begin
  if all_fleets
    root_namespace = LocalModelEvaluation::RunpodFleetNamespace.new(
      root: state_root,
      repo_root: state_repo_root,
      fleet_key: LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY
    )
    fleet_keys = [
      LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY,
      *root_namespace.registered_fleet_keys
    ].uniq

    entries = fleet_keys.filter_map do |fleet_key|
      namespace = if fleet_key == LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY
                    root_namespace
                  else
                    LocalModelEvaluation::RunpodFleetNamespace.new(
                      root: state_root,
                      repo_root: state_repo_root,
                      fleet_key: fleet_key
                    )
                  end
      _status, snapshot = build_status.call(namespace)
      next unless snapshot

      { "fleet_key" => fleet_key, "snapshot" => snapshot }
    end

    overview = LocalModelEvaluation::RunpodStatusAll.new
    snapshot = overview.snapshot(entries)
    if options[:json]
      puts JSON.pretty_generate(snapshot)
    elsif options[:verbose]
      $stdout.write(overview.render(snapshot))
      shutdown = LocalModelEvaluation::RunpodShutdownControl.new(root: state_root, repo_root: state_repo_root)
      $stdout.write("\n")
      $stdout.write(shutdown.render(fleet_aliases: snapshot.fetch("fleet_aliases")))
      cost = LocalModelEvaluation::RunpodCostControl.new(root: state_root, repo_root: state_repo_root)
      $stdout.write("\n")
      $stdout.write(cost.render)
    else
      $stdout.write(compact.render_all(snapshot))
    end
  else
    namespace = LocalModelEvaluation::RunpodFleetNamespace.new(
      root: state_root,
      repo_root: state_repo_root,
      fleet_key: ENV.fetch("LME_RUNPOD_FLEET", LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY)
    )
    status, snapshot = build_status.call(namespace)
    if options[:json]
      puts JSON.pretty_generate(snapshot)
    elsif options[:verbose]
      $stdout.write(status.render(snapshot))
    else
      $stdout.write(compact.render_fleet(snapshot))
    end
  end
rescue LocalModelEvaluation::RunpodFleetNamespace::Error,
       LocalModelEvaluation::RunpodStatus::Error,
       LocalModelEvaluation::RunpodFleetState::Error,
       LocalModelEvaluation::RunpodCostControl::Error,
       LocalModelEvaluation::RunpodShutdownControl::Error,
       OptionParser::ParseError,
       ArgumentError => e
  warn "ERROR: #{e.message}"
  exit 1
end
