#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "optparse"
require "rbconfig"

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "local_model_evaluation"

ENV["LME_REPO"] = ROOT

def selected_fleet_key
  ENV.fetch("LME_RUNPOD_FLEET", LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY)
end

def namespace_for(fleet_key = selected_fleet_key, create: false, provisional: false)
  LocalModelEvaluation::RunpodFleetNamespace.new(
    root: File.join(ROOT, "output", "runpod-fleets"), repo_root: ROOT,
    fleet_key:, create:, provisional:
  )
end

def runpod_api_key
  key = ENV["RUNPOD_API_KEY"].to_s
  abort "RUNPOD_API_KEY is missing; add it to the repo-local .env file." if key.empty?
  key
end

def runpod_client
  LocalModelEvaluation::RunpodClient.new(
    api_key: runpod_api_key,
    base_url: ENV.fetch("RUNPOD_API_BASE_URL", LocalModelEvaluation::RunpodClient::DEFAULT_BASE_URL)
  )
end

def fleet_for(namespace:)
  LocalModelEvaluation::RunpodFleet.new(
    client: runpod_client, env_path: namespace.env_path, state_root: namespace.state_root,
    fleet_key: namespace.fleet_key, local_port_base: namespace.local_port_base
  )
end

def confirm_or_abort(prompt, assume_yes: false)
  return if assume_yes
  $stdout.print "#{prompt} [y/N] "
  $stdout.flush
  abort "Aborted; no changes made." unless %w[y yes].include?($stdin.gets.to_s.strip.downcase)
end

def extract_fleet_option!(argv)
  fleet = nil
  index = 0
  while index < argv.length
    token = argv[index]
    if token == "--fleet"
      abort "--fleet requires a key" if index + 1 >= argv.length
      fleet = argv[index + 1]
      argv.slice!(index, 2)
    elsif token.start_with?("--fleet=")
      fleet = token.split("=", 2).last
      argv.delete_at(index)
    else
      index += 1
    end
  end
  fleet
end

def create_options(argv)
  opts = {
    workers: nil, cloud: LocalModelEvaluation::RunpodFleet::DEFAULT_CLOUD,
    gpu_id: LocalModelEvaluation::RunpodFleet::GPU_ID,
    container_disk_gb: LocalModelEvaluation::RunpodFleet::DEFAULT_CONTAINER_DISK_GB,
    volume_gb: nil, network_volume_id: nil,
    max_runtime_seconds: nil, max_spend_usd: nil, min_ready_workers: nil, dry_run: false, yes: false,
    max_hourly_usd: ENV.fetch("RUNPOD_MAX_FLEET_HOURLY_USD", LocalModelEvaluation::RunpodFleet::DEFAULT_MAX_FLEET_HOURLY_USD),
    max_total_hourly_usd: ENV.fetch("RUNPOD_MAX_TOTAL_HOURLY_USD", LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_MAX_TOTAL_HOURLY_USD),
    ssh_public_key: ENV.fetch("RUNPOD_SSH_PUBLIC_KEY_PATH", "~/.ssh/id_ed25519.pub"),
    wait_seconds: LocalModelEvaluation::RunpodFleet::DEFAULT_WAIT_SECONDS,
    poll_seconds: LocalModelEvaluation::RunpodFleet::DEFAULT_POLL_SECONDS
  }
  OptionParser.new do |o|
    o.on("--workers N", Integer) { |v| opts[:workers] = v }
    o.on("--min-ready-workers N", Integer, "Accept once this many leading workers are ready") { |v| opts[:min_ready_workers] = v }
    o.on("--cloud TIER") { |v| opts[:cloud] = v }
    o.on("--gpu GPU_ID") { |v| opts[:gpu_id] = v }
    o.on("--container-disk-gb N", Integer) { |v| opts[:container_disk_gb] = v }
    o.on("--network-volume-id ID", "Attach an existing network volume at /workspace on every worker") { |v| opts[:network_volume_id] = v }
    o.on("--volume-gb N", Integer) { |v| opts[:volume_gb] = v }
    o.on("--max-runtime-minutes MINUTES", Float) { |v| opts[:max_runtime_seconds] = v * 60.0 }
    o.on("--max-spend-usd USD", Float) { |v| opts[:max_spend_usd] = v }
    o.on("--dry-run") { opts[:dry_run] = true }
    o.on("--yes") { opts[:yes] = true }
    o.on("--max-hourly-usd USD", Float) { |v| opts[:max_hourly_usd] = v }
    o.on("--max-total-hourly-usd USD", Float) { |v| opts[:max_total_hourly_usd] = v }
    o.on("--ssh-public-key PATH") { |v| opts[:ssh_public_key] = v }
    o.on("--wait-seconds N", Integer) { |v| opts[:wait_seconds] = v }
    o.on("--poll-seconds N", Float) { |v| opts[:poll_seconds] = v }
  end.parse!(argv)
  abort "--network-volume-id cannot be combined with --volume-gb" if opts[:network_volume_id] && opts[:volume_gb]
  abort "Usage: bin/rpof create --workers N [--dry-run|--yes]" unless opts[:workers]
  if opts[:min_ready_workers] && !opts[:min_ready_workers].between?(1, opts[:workers])
    abort "--min-ready-workers must be between 1 and --workers"
  end
  opts
end

def destroy_options(argv)
  opts = { workers: nil, all: false, yes: false }
  OptionParser.new do |o|
    o.on("--workers LIST") { |v| opts[:workers] = LocalModelEvaluation::RunpodWorkers.parse_selector(v) }
    o.on("--all") { opts[:all] = true }
    o.on("--yes") { opts[:yes] = true }
  end.parse!(argv)
  abort "use either --workers or --all, not both" if opts[:workers] && opts[:all]
  abort "Usage: bin/rpof destroy (--workers LIST|--all) [--yes]" unless opts[:workers] || opts[:all]
  opts
rescue LocalModelEvaluation::RunpodWorkers::Error => e
  abort e.message
end

def start_lease_watchdog!(namespace:, fleet:, workers:)
  record = fleet.fleet_state.current
  return nil unless record && record["lease"]
  lease_dir = fleet.fleet_state.artifact_dir(record.fetch("fleet_id"), "lease")
  FileUtils.mkdir_p(lease_dir)
  log_path = File.join(lease_dir, LocalModelEvaluation::RunpodLease::LOG_FILE)
  log = File.open(log_path, "a")
  command = [RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lease"), "watch",
             "--fleet", namespace.fleet_key, "--expected-fleet-id", record.fetch("fleet_id")]
  pid = Process.spawn(*command, chdir: ROOT, in: File::NULL, out: log, err: [:child, :out], pgroup: true)
  Process.detach(pid)
  puts "Lease watchdog: pid #{pid}; log #{log_path}"
  pid
rescue SystemCallError => e
  teardown_error = nil
  begin
    fleet.destroy(worker_indices: workers.map(&:index))
  rescue StandardError => destroy_error
    teardown_error = destroy_error
  end
  detail = teardown_error ? "; emergency teardown also failed: #{teardown_error.message}" : "; newly-created fleet was torn down"
  raise LocalModelEvaluation::RunpodFleet::Error, "could not start lease watchdog: #{e.message}#{detail}"
ensure
  log&.close
end

fleet_option = extract_fleet_option!(ARGV)
ENV["LME_RUNPOD_FLEET"] = LocalModelEvaluation::RunpodFleetNamespace.normalize_key(fleet_option) if fleet_option
command = ARGV.shift

case command
when "create"
  opts = create_options(ARGV)
  fleet_key = selected_fleet_key
  begin
    namespace = namespace_for(fleet_key, provisional: true)
    fleet = fleet_for(namespace:)
    fleet.gpu_id = opts[:gpu_id]
    preflight = fleet.preflight(
      worker_count: opts[:workers], cloud: opts[:cloud], max_fleet_hourly_usd: opts[:max_hourly_usd],
      container_disk_gb: opts[:container_disk_gb], volume_gb: opts[:volume_gb],
      network_volume_id: opts[:network_volume_id],
      max_runtime_seconds: opts[:max_runtime_seconds], max_spend_usd: opts[:max_spend_usd]
    )
    ssh_public_key = fleet.read_ssh_public_key(opts[:ssh_public_key])
    current_total_rate = namespace.total_active_hourly_usd
    projected_total_rate = current_total_rate + preflight.fleet_hourly_rate
    max_total_rate = Float(opts[:max_total_hourly_usd])
    raise LocalModelEvaluation::RunpodFleet::Error, "aggregate managed RunPod hourly safety cap must be a positive number" unless max_total_rate.positive?
    if projected_total_rate > max_total_rate
      raise LocalModelEvaluation::RunpodFleet::Error, format(
        "projected managed RunPod total $%.4f/hr exceeds aggregate safety cap $%.4f/hr; no pods were created",
        projected_total_rate, max_total_rate
      )
    end
    puts "RunPod fleet preflight"
    puts "  Fleet: #{namespace.fleet_key}"
    puts "  GPU: #{preflight.gpu.fetch('id')} (#{preflight.gpu.fetch('memory')} GB VRAM)"
    puts "  Cloud: #{preflight.cloud}"
    puts "  Availability: #{preflight.availability}"
    puts "  Workers: #{preflight.worker_count}"
    minimum_ready_workers = opts[:min_ready_workers] || preflight.worker_count
    puts "  Minimum ready workers: #{minimum_ready_workers}"
    if minimum_ready_workers < preflight.worker_count
      puts "  Partial acceptance: activate once that many leading workers are ready"
      puts "  and delete any unaccepted requested tail workers before fleet activation."
    end
    puts "  Container disk: #{preflight.container_disk_gb} GB"
    if preflight.network_volume_id
      puts "  Existing network volume: #{preflight.network_volume_id} at #{LocalModelEvaluation::RunpodFleet::VOLUME_MOUNT_PATH} on every worker"
      puts "  No fresh per-pod workspace volume will be created."
      puts "  Bootstrap shared models with --reuse-existing --state-root /root/lme-worker-state."
      puts "  GPU catalog availability is not specific to the network volume's data center."
    else
      puts "  Workspace volume: #{preflight.volume_gb} GB at #{LocalModelEvaluation::RunpodFleet::VOLUME_MOUNT_PATH}"
    end
    puts format("  Catalog rate: $%.4f/hr per worker", preflight.hourly_rate)
    puts format("  Projected fleet rate: $%.4f/hr", preflight.fleet_hourly_rate)
    puts format("  Projected 10-minute cost: $%.4f", preflight.fleet_hourly_rate / 6.0)
    puts format("  Projected 30-minute cost: $%.4f", preflight.fleet_hourly_rate / 2.0)
    puts format("  Per-fleet safety cap: $%.4f/hr", preflight.max_fleet_hourly_rate)
    puts format("  Existing managed fleets: $%.4f/hr", current_total_rate)
    puts format("  Projected managed total: $%.4f/hr", projected_total_rate)
    puts format("  Aggregate safety cap: $%.4f/hr", max_total_rate)
    puts format("  Runtime lease: %.1f minutes", preflight.max_runtime_seconds / 60.0) if preflight.max_runtime_seconds
    puts format("  Spend lease: $%.4f", preflight.max_spend_usd) if preflight.max_spend_usd
    puts "  Lease enforcement: local detached watchdog after fleet activation" if preflight.max_runtime_seconds || preflight.max_spend_usd
    puts "  SSH public key: #{File.expand_path(opts[:ssh_public_key])}"
    puts "No pods have been created."
    if opts[:dry_run]
      puts "Dry run PASS."
      exit 0
    end
    confirm_or_abort(
      format("Create %d paid RunPod %s worker(s) in fleet %s at $%.4f/hr (projected managed total $%.4f/hr)?",
             preflight.worker_count, preflight.cloud, fleet_key, preflight.fleet_hourly_rate, projected_total_rate),
      assume_yes: opts[:yes]
    )
    namespace = namespace_for(fleet_key, create: true)
    fleet = fleet_for(namespace:)
    fleet.gpu_id = opts[:gpu_id]
    workers = fleet.create(
      worker_count: opts[:workers], cloud: opts[:cloud], ssh_public_key:, preflight:,
      max_fleet_hourly_usd: opts[:max_hourly_usd], container_disk_gb: opts[:container_disk_gb],
      volume_gb: opts[:volume_gb], network_volume_id: opts[:network_volume_id], max_runtime_seconds: opts[:max_runtime_seconds],
      max_spend_usd: opts[:max_spend_usd], min_ready_workers: minimum_ready_workers,
      wait_seconds: opts[:wait_seconds], poll_seconds: opts[:poll_seconds]
    )
    start_lease_watchdog!(namespace:, fleet:, workers:)
    puts "RunPod fleet ready:"
    workers.each { |worker| puts format("  burst_%d: pod=%s ssh=%s:%d $%.4f/hr", worker.index, worker.pod_id, worker.host, worker.ssh_port, worker.hourly_rate) }
    puts format("Actual fleet rate: $%.4f/hr", workers.sum(&:hourly_rate))
    puts "Provisioning stopped here: no Ollama bootstrap, tunnels, worker-check, or scoring were started."
  rescue ArgumentError, TypeError
    warn "ERROR: aggregate managed RunPod hourly safety cap must be a positive number"
    exit 1
  rescue LocalModelEvaluation::RunpodClient::Error, LocalModelEvaluation::RunpodFleet::Error,
         LocalModelEvaluation::RunpodFleetNamespace::Error => e
    warn "ERROR: #{e.message}"
    exit 1
  end
when "destroy"
  opts = destroy_options(ARGV)
  fleet_key = selected_fleet_key
  begin
    namespace = namespace_for(fleet_key)
    if opts[:all]
      current = LocalModelEvaluation::RunpodFleetState.new(root: namespace.state_root, local_port_base: namespace.local_port_base).current
      raise LocalModelEvaluation::RunpodFleet::Error, "no active workers exist in fleet #{fleet_key}" unless current && current["status"] == "active"
      opts[:workers] = current.fetch("workers").filter_map { |worker| Integer(worker.fetch("index")) if worker["status"] == "active" }
      raise LocalModelEvaluation::RunpodFleet::Error, "no active workers exist in fleet #{fleet_key}" if opts[:workers].empty?
    end
    confirm_or_abort("Permanently delete RunPod fleet #{fleet_key} worker(s): #{opts[:workers].map { |i| "burst_#{i}" }.join(', ')}?", assume_yes: opts[:yes])
    state = LocalModelEvaluation::RunpodFleetState.new(root: namespace.state_root, local_port_base: namespace.local_port_base)
    current = state.current
    if current
      active = current.fetch("workers").filter_map do |worker|
        index = Integer(worker.fetch("index"))
        index if worker["status"] == "active" && opts[:workers].include?(index)
      end
      unless active.empty?
        tunnel_root = state.artifact_dir(current.fetch("fleet_id"), "tunnels")
        if File.file?(File.join(tunnel_root, LocalModelEvaluation::RunpodTunnels::STATE_FILE))
          LocalModelEvaluation::RunpodTunnels.new(fleet_state: state, repo_root: ROOT).stop(worker_indices: active)
        end
      end
    end
    cleared = fleet_for(namespace:).destroy(worker_indices: opts[:workers])
    puts "RunPod teardown complete for fleet #{fleet_key}: #{cleared.map { |i| "burst_#{i}" }.join(', ')}"
  rescue LocalModelEvaluation::RunpodFleetState::Error, LocalModelEvaluation::RunpodTunnels::Error => e
    warn "WARNING: could not stop managed local tunnel(s): #{e.message}; continuing paid pod teardown."
    begin
      cleared = fleet_for(namespace:).destroy(worker_indices: opts[:workers])
      puts "RunPod teardown complete for fleet #{fleet_key}: #{cleared.map { |i| "burst_#{i}" }.join(', ')}"
    rescue LocalModelEvaluation::RunpodClient::Error, LocalModelEvaluation::RunpodFleet::Error,
           LocalModelEvaluation::RunpodFleetNamespace::Error => destroy_error
      warn "ERROR: #{destroy_error.message}"
      exit 1
    end
  rescue KeyError, ArgumentError, TypeError, LocalModelEvaluation::RunpodClient::Error,
         LocalModelEvaluation::RunpodFleet::Error, LocalModelEvaluation::RunpodFleetNamespace::Error => e
    warn "ERROR: #{e.message}"
    exit 1
  end
else
  warn "Usage: bin/rpof-fleet (create|destroy) [options]"
  exit 2
end
