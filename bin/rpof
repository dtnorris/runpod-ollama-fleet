#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

ROOT = File.expand_path("..", __dir__)

command = ARGV.shift

case command
when "version"
  $LOAD_PATH.unshift File.join(ROOT, "lib")
  require "runpod_ollama_fleet/version"
  puts RunpodOllamaFleet::VERSION
when "capability-check"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-capability-check"), *ARGV
when "capacity"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-capacity"), *ARGV
when "campaign"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-campaign"), *ARGV
when "fulfill"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-fulfill"), *ARGV
when "runtime-alias"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-runtime-alias"), *ARGV
when "workers"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-workers"), *ARGV
when "create"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-fleet"), "create", *ARGV
when "destroy"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-fleet"), "destroy", *ARGV
when "bootstrap"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-bootstrap"), *ARGV
when "lease"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lease"), *ARGV
when "cost"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-cost"), *ARGV
when "budget"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-budget"), *ARGV
when "shutdown"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-shutdown"), "shutdown", *ARGV
when "keep"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-shutdown"), "keep", *ARGV
when "scale"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lifecycle"), "scale", *ARGV
when "replace"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lifecycle"), "replace", *ARGV
when "status"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-status"), *ARGV
when "tunnels"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-tunnels"), *ARGV
else
  warn <<~USAGE
    Usage: bin/rpof COMMAND [options]

    Capacity and worker-registry commands (current production surface):
      version
      capacity
      campaign
      fulfill
      runtime-alias
      workers
      create
      destroy
      bootstrap
      lease
      cost
      budget
      shutdown
      keep
      scale
      replace
      status
      tunnels

    Read-only capability checks:
      capability-check

    Campaigns and workers provide capacity and discovery. Historical workload
    dispatch and execution-pool fulfillment are retired; contracts remain readable.

    Process ownership and Ctrl-C:
      campaign plan/status, workers, status, capacity, capability-check
        ONE-SHOT INSPECTION/PUBLICATION. Ctrl-C interrupts only this request;
        it does not stop WLO execution or paid provider resources.
      campaign start
        RESOURCE MUTATION. This initiating CLI is short-lived. Paid resources
        and the independent budget guardian continue after it returns or its
        terminal exits; the guardian is a safety enforcer, not a campaign controller.
      campaign stop
        TEARDOWN REQUEST. The guardian owns continued teardown. Success is not
        complete until campaign status reports CLOSED with provider absence verified.
      create, fulfill, scale, replace
        MANUAL RESOURCE MUTATION. Automated --yes paid forms are blocked; use
        campaign start for production automation. Ctrl-C is not rollback or teardown;
        provider resources and detached compatibility watchdogs may remain.
      destroy, shutdown
        TEARDOWN REQUEST. Ctrl-C does not prove provider absence; inspect status
        and repeat the explicit teardown command when necessary.
      bootstrap, runtime-alias
        FOREGROUND WORK OWNER. Ctrl-C interrupts the CLI, not WLO or paid capacity.
      tunnels start/repair
        DETACHED WORK LAUNCHER. Healthy SSH tunnel processes outlive this CLI;
        use `tunnels stop` to stop tunnels. That still does not delete provider capacity.
      lease watch, cost watch
        FOREGROUND WORK OWNER when invoked directly. Ctrl-C stops only that
        watchdog process; it does not delete paid resources.

    WLO pause and RPOF teardown are separate lifecycle actions. Closing a view,
    interrupting a CLI, or losing a shell/terminal is never a substitute for either.
  USAGE
  exit(command ? 2 : 0)
end
