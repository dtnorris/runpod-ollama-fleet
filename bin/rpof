#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

ROOT = File.expand_path("..", __dir__)

command = ARGV.shift

case command
when "version"
  $LOAD_PATH.unshift File.join(ROOT, "lib")
  require "runpod_ollama_fleet/version"
  puts RunpodOllamaFleet::VERSION
when "capability-check"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-capability-check"), *ARGV
when "capacity"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-capacity"), *ARGV
when "campaign"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-campaign"), *ARGV
when "fulfill"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-fulfill"), *ARGV
when "runtime-alias"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-runtime-alias"), *ARGV
when "workers"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-workers"), *ARGV
when "create"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-fleet"), "create", *ARGV
when "destroy"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-fleet"), "destroy", *ARGV
when "bootstrap"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-bootstrap"), *ARGV
when "lease"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lease"), *ARGV
when "cost"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-cost"), *ARGV
when "budget"
  exec RbConfig.ruby, File.join(ROOT, "bin", "rpof-budget"), *ARGV
when "shutdown"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-shutdown"), "shutdown", *ARGV
when "keep"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-shutdown"), "keep", *ARGV
when "scale"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lifecycle"), "scale", *ARGV
when "replace"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lifecycle"), "replace", *ARGV
when "status"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-status"), *ARGV
when "tunnels"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-tunnels"), *ARGV
else
  warn <<~USAGE
    Usage: bin/rpof COMMAND [options]

    Capacity and worker-registry commands (current production surface):
      version
      capacity
      campaign
      fulfill
      runtime-alias
      workers
      create
      destroy
      bootstrap
      lease
      cost
      budget
      shutdown
      keep
      scale
      replace
      status
      tunnels

    Read-only capability checks:
      capability-check

    Campaigns and workers provide capacity and discovery. Historical workload
    dispatch and execution-pool fulfillment are retired; contracts remain readable.
  USAGE
  exit(command ? 2 : 0)
end
