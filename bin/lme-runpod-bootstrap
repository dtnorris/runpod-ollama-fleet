#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift File.join(ROOT, "lib")

require "local_model_evaluation/runpod_fleet_namespace"
require "local_model_evaluation/runpod_fleet_state"
require "local_model_evaluation/runpod_bootstrap"
require "local_model_evaluation/runpod_workers"

def parse_worker_indices(value)
  LocalModelEvaluation::RunpodWorkers.parse_selector(value)
rescue LocalModelEvaluation::RunpodWorkers::Error => e
  raise OptionParser::InvalidArgument, e.message
end

opts = {
  workers: nil,
  models: [],
  expected_digests: [],
  clean: false,
  reuse_existing: false,
  copy_to_workspace: false,
  keep_root_models: false,
  context: nil,
  state_root: nil,
  fleet_key: ENV.fetch("LME_RUNPOD_FLEET", LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY),
  heartbeat_seconds: ENV.fetch(
    "LME_RUNPOD_BOOTSTRAP_HEARTBEAT_SECONDS",
    LocalModelEvaluation::RunpodBootstrap::DEFAULT_HEARTBEAT_SECONDS
  )
}

parser = OptionParser.new do |o|
  o.banner = "Usage: bin/lme runpod-bootstrap --workers 1-16 --model MODEL [options]"
  o.on("--workers LIST", "Burst worker indices, e.g. 1-12 or 1,6,12") { |v| opts[:workers] = parse_worker_indices(v) }
  o.on("--model MODEL", "Ollama model to bootstrap; repeatable") { |v| opts[:models] << v }
  o.on("--expect-digest MODEL=DIGEST", "Required exact 64-hex digest for each --model; repeatable") { |v| opts[:expected_digests] << v }
  o.on("--clean", "Delete staging/shared Ollama stores before bootstrap") { opts[:clean] = true }
  o.on("--reuse-existing", "Reuse and validate the existing /workspace Ollama cache; never pull or copy models") { opts[:reuse_existing] = true }
  o.on("--copy-to-workspace", "Persist pulled model data to /workspace; fresh single-model bootstrap stays on root by default") { opts[:copy_to_workspace] = true }
  o.on("--keep-root-models", "Compatibility flag; fresh single-model bootstrap already stays on root by default") { opts[:keep_root_models] = true }
  o.on("--fleet KEY", "Select the managed fleet") { |v| opts[:fleet_key] = v }
  o.on("--state-root PATH", "Remote worker evidence root (default: /workspace/lme-worker-state)") { |v| opts[:state_root] = v }
  o.on("--context N", Integer, "Ollama context length; remote default is 131072") { |v| opts[:context] = v }
  o.on("--heartbeat-seconds N", Float, "Fleet heartbeat interval (default: 10)") { |v| opts[:heartbeat_seconds] = v }
end

begin
  parser.parse!(ARGV)
  raise OptionParser::MissingArgument, "--workers" unless opts[:workers]
  raise OptionParser::MissingArgument, "--model" if opts[:models].empty?
  if opts[:clean] && opts[:reuse_existing]
    raise OptionParser::InvalidArgument, "--clean cannot be combined with --reuse-existing"
  end
  if opts[:copy_to_workspace] && opts[:reuse_existing]
    raise OptionParser::InvalidArgument, "--copy-to-workspace cannot be combined with --reuse-existing"
  end
  if opts[:copy_to_workspace] && opts[:keep_root_models]
    raise OptionParser::InvalidArgument, "--copy-to-workspace cannot be combined with --keep-root-models"
  end
  if opts[:keep_root_models] && opts[:reuse_existing]
    raise OptionParser::InvalidArgument, "--keep-root-models cannot be combined with --reuse-existing"
  end
  if opts[:keep_root_models] && opts[:models].length != 1
    raise OptionParser::InvalidArgument, "--keep-root-models requires exactly one --model"
  end
  if !opts[:reuse_existing] && !opts[:copy_to_workspace] && opts[:models].length != 1
    raise OptionParser::InvalidArgument, "fresh root-storage bootstrap requires exactly one --model; use --copy-to-workspace for multiple models"
  end
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
rescue OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  warn parser
  exit 2
end

begin
  namespace = LocalModelEvaluation::RunpodFleetNamespace.new(
    root: File.join(ROOT, "output", "runpod-fleets"),
    repo_root: ROOT,
    fleet_key: opts[:fleet_key]
  )
  ENV["LME_RUNPOD_FLEET"] = namespace.fleet_key
  state = LocalModelEvaluation::RunpodFleetState.new(
    root: namespace.state_root,
    local_port_base: namespace.local_port_base
  )
  bootstrap = LocalModelEvaluation::RunpodBootstrap.new(
    fleet_state: state,
    remote_setup_path: File.join(ROOT, "scripts", "setup_runpod_worker_remote.sh"),
    repo_root: ROOT
  )
  bootstrap.run(
    worker_indices: opts[:workers],
    models: opts[:models],
    expected_digests: opts[:expected_digests],
    clean: opts[:clean],
    reuse_existing: opts[:reuse_existing],
    copy_to_workspace: opts[:copy_to_workspace],
    keep_root_models: opts[:keep_root_models],
    context: opts[:context],
    state_root: opts[:state_root],
    heartbeat_seconds: opts[:heartbeat_seconds]
  )
rescue Interrupt
  exit 130
rescue LocalModelEvaluation::RunpodBootstrap::Error, LocalModelEvaluation::RunpodFleetNamespace::Error => e
  warn "ERROR: #{e.message}"
  exit 1
end
